#!/bin/sh
set -eu

stats=$(git diff --cached --numstat)
files=0
lines=0
tab=$(printf '\t')

while IFS="$tab" read -r added deleted path; do
  [ -z "$path" ] && continue
  files=$((files + 1))
  [ "$added" = "-" ] || lines=$((lines + added))
  [ "$deleted" = "-" ] || lines=$((lines + deleted))
done <<EOF
$stats
EOF

if [ "$files" -gt 5 ] || [ "$lines" -gt 150 ]; then
  printf 'Commit rejected: staged diff has %d files and %d changed lines.\n' "$files" "$lines" >&2
  printf '%s\n' 'Commit one verified function or logical block at a time (maximum: 5 files, 150 added-plus-deleted lines).' >&2
  exit 1
fi
