# Model/search backends
LLM_BACKEND=anthropic
EMBED_BACKEND=voyage
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
MODEL_SYNTHESIS=claude-opus-4-8
MODEL_EXTRACTION=claude-sonnet-4-6
MODEL_CLASSIFY=claude-haiku-4-5
TRANSCRIBE_MEDIA=true
SEARCH_ENABLED=true
WHISPER_MODEL=base

# Application and authentication (JSON maps)
MARKOV_DATABASE_PATH=data/markov.db
MARKOV_API_KEYS={"replace-customer-key":"customer-1"}
MARKOV_INTERNAL_API_KEYS={"replace-reviewer-key":"reviewer-1"}
MARKOV_WEB_SESSION_SECRET=replace-with-a-long-random-secret
MARKOV_API_RATE_LIMIT_PER_MINUTE=60

# Configurable six-product credit catalog
MARKOV_OPENING_CREDITS=0
MARKOV_PRODUCT_CREDIT_COSTS={"brief_instant":1,"brief_verified":3,"research_instant":3,"research_verified":6,"script_instant":4,"script_verified":8}

# Optional Stripe credit packs. STRIPE_PRICE_IDS maps pack name -> Price id.
# STRIPE_CREDIT_PACKS maps Price id -> granted credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={}
STRIPE_CREDIT_PACKS={}
STRIPE_SUCCESS_URL=http://localhost:8000/app?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/app?payment=cancelled

# Outbound webhook signing and actual internal variable cost
MARKOV_WEBHOOK_SIGNING_SECRET=
MARKOV_HUMAN_REVIEW_HOURLY_COST=0
